# Copy to .env for local overrides when using Docker dev.
# MONGO_URL is always overridden in docker-compose.dev.yml to mongodb://mongo:27017/vog_ecom

PORT=8013
NODE_ENV=development

JWT_EXPIRES=24h
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES=7d

BUCKET_NAME=local-dev-bucket
SECRET_ACCESS_KEY=local-dev-secret
ACCESS_KEY_ID=local-dev-access-key

RESEND_PASSKEY=re_dev_local_placeholder

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
