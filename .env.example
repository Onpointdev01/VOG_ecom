PORT=8013
NODE_ENV=development
# Local Docker Mongo
# MONGO_URL=mongodb://127.0.0.1:27017/vog_ecom
# MongoDB Atlas (add /DATABASE_NAME before ?)
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vog_ecom?retryWrites=true&w=majority&appName=ecomm
MONGO_URL=mongodb://127.0.0.1:27017/vog_ecom

JWT_EXPIRES=24h
JWT_COOKIE_EXPIRES_IN=24
JWT_SECRET=myNewSecret
JWT_REFRESH_SECRET=myNewJwtRefreshSecret
JWT_REFRESH_EXPIRES=7d

BUCKET_NAME=local-dev-bucket
SECRET_ACCESS_KEY=local-dev-secret
ACCESS_KEY_ID=local-dev-access-key

# Gmail SMTP (use an App Password: Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=VOG <your@gmail.com>

#google_for_google_login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Order approval: ADMIN_ONLY (default) | SELLER_ALLOWED
# DB admin settings override this after first save.
ORDER_APPROVAL_MODE=ADMIN_ONLY

# OneSignal push (mobile app)
ONESIGNAL_APP_ID=cc23bbd7-7885-4b8e-af92-14c426e29f89
ONESIGNAL_REST_API_KEY=
