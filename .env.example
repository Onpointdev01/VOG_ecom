PORT=8013
NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/your-database-name

JWT_EXPIRES=24h
JWT_COOKIE_EXPIRES_IN=24
JWT_SECRET=myNewSecret
JWT_REFRESH_SECRET= myNewJwtRefreshSecret
JWT_REFRESH_EXPIRES= 7d

RESEND_PASSKEY=

#google_for_google_login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Admin — REQUIRED for POST /auth/firebase-social-login (verify mobile Firebase ID tokens).
# Use the SAME Firebase project as the app (e.g. vog-ecom).
#
# Option A — path to JSON file (path is relative to process cwd, usually backend/ when you run npm run dev):
# FIREBASE_SERVICE_ACCOUNT_PATH=./google-service-account.json
#
# Option B — paste full service account JSON as one line (escape inner double quotes if needed):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"vog-ecom",...}
#
# Option B — from the same JSON file:
# FIREBASE_PROJECT_ID=vog-ecom
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vog-ecom.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
