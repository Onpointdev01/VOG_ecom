PORT=8013
NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/your-database-name

JWT_EXPIRES=24h
JWT_COOKIE_EXPIRES_IN=24
JWT_SECRET=myNewSecret
JWT_REFRESH_SECRET= myNewJwtRefreshSecret
JWT_REFRESH_EXPIRES= 7d

# Gmail SMTP (App Password — Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=your@gmail.com

# Optional site URLs for password-reset links in emails
BUYER_WEBSITE_URL=https://market.st-cael.org
SELLER_WEBSITE_URL=https://seller.st-cael.org

#google_for_google_login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
