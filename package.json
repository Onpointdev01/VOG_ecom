{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/utils/templates','dist/utils/templates',{recursive:true})\"",
    "build:clean": "rimraf dist && tsc && node -e \"require('fs').cpSync('src/utils/templates','dist/utils/templates',{recursive:true})\"",
    "dev": "cross-env NODE_ENV=development  nodemon",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:detach": "docker compose -f docker-compose.dev.yml up --build -d",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:logs": "docker compose -f docker-compose.dev.yml logs -f api",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d mongo",
    "dev:db:stop": "docker compose -f docker-compose.dev.yml stop mongo",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "test": "yarn run unit-test && yarn run integration-test",
    "new-test": "yarn run build && cross-env NODE_ENV=test TEST_TYPE=unit mocha dist/_test_/unit/service/user/banUserLogic.js --recursive --exit --timeout 25000",
    "format": "prettier --write src/",
    "coverage": "nyc yarn run unit-test",
    "integration-test": "echo 'no integration tests yet'",
    "unit-test": "npm run build && mocha \"dist/_test_/unit/**/*.test.js\" --recursive --exit --timeout 10000",
    "serve:dev": "cross-env NODE_ENV=production  nodemon",
    "seed:attributes": "ts-node src/utils/seedAttributes.ts",
    "seed:shipping-zones": "ts-node src/utils/seedShippingZones.ts",
    "seed:shipping-zones:force": "ts-node src/utils/seedShippingZones.ts --force",
    "migrate:shipping-neighborhoods": "ts-node scripts/migrate-shipping-to-neighborhoods.ts --force",
    "migrate:seller-promotion": "ts-node scripts/migrate-seller-promotion.ts",
    "migrate:bids-to-offers": "ts-node scripts/migrate-bids-to-offers.ts",
    "migrate:bids-to-offers:dry": "ts-node scripts/migrate-bids-to-offers.ts --dry-run",
    "products:sync-availability": "ts-node scripts/sync-product-availability.ts",
    "products:sync-availability:apply": "ts-node scripts/sync-product-availability.ts --apply"
  },
  "overrides": {
    "eslint": "^9.6.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.13",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.0",
    "@types/reflect-metadata": "^0.1.0",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.12.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.6.0",
    "globals": "^15.8.0",
    "jest": "^30.4.2",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/express-serve-static-core": "^4.19.5",
    "@types/multer": "^1.4.12",
    "@types/multer-s3": "^3.0.3",
    "aws-sdk": "^2.1682.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^9.13.0",
    "inversify": "^6.0.2",
    "inversify-express-utils": "^6.4.6",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^8.0.7",
    "qs": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^3.5.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0",
    "winston": "^3.13.1"
  }
}
