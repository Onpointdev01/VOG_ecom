# Copy into .env — use the same database name you open in Compass (often "test" or "vog_ecom")
# If mongodb+srv fails with querySrv ECONNREFUSED, use the standard URI from Atlas (Connect → Drivers → "Standard connection string").
# MONGO_URL=mongodb+srv://USER:PASSWORD@ecomm.fi9ysyu.mongodb.net/vog_ecom?retryWrites=true&w=majority&appName=ecomm
MONGO_URL=mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/vog_ecom?ssl=true&authSource=admin&retryWrites=true&w=majority
